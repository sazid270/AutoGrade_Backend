# Production Environment
PRODUCTION=True or False # Set to True for production

# Django settings
SECRET_KEY=your_secret_key_here
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com # Add multiple domains separated by commas (for production)

# CORS settings (for production)
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com # URLs separated by commas

# PostgreSQL database settings (for production)
POSTGRESQL_DATABASE_URL='your_postgresql_database_url_here'

# PostgreSQL database settings
POSTGRESQL_DATABASE=your_database_name
POSTGRESQL_USER=your_db_user
POSTGRESQL_ROOT_PASSWORD=your_db_root_password
POSTGRESQL_HOST=your_db_host
POSTGRESQL_PORT=your_db_port

# OTP settings
OTP_VERIFICATION_TIME=30
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_TIME=1

# Email settings
EMAIL_HOST=smtp.gmail.com
EMAIL_USE_TLS=True
EMAIL_PORT=587
EMAIL_HOST_USER=test@gmail.com
EMAIL_HOST_PASSWORD=test123

# Google OAuth settings
GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
